[Unit]
Description=Kiosk TUI Leaderboard
After=systemd-user-sessions.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<your-user>
WorkingDirectory=/opt/leaderboard
ExecStart=/opt/leaderboard/leaderboard
Restart=always
RestartSec=2

StandardInput=tty-force
StandardOutput=tty
StandardError=journal

TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no

Environment=TERM=linux
Environment=LANG=nb_NO.UTF-8

[Install]
WantedBy=multi-user.target
